#!/bin/sh /etc/rc.common
#
# Cell blacklist enforcement. Starts after the cellular manager so the modem
# is already up when the first poll runs.

START=95
STOP=10

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/bin/gl_cellguard run
	procd_set_param respawn 5 10 -1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/gl_cellguard.json
	# A lock outlives the daemon. Left in place it pins the modem to one cell
	# with nothing running to ever let go, which on this device ended as a
	# modem parked on 3G. `release` only touches the modem if a lock is held.
	/usr/bin/lua /usr/bin/gl_cellguard release >/dev/null 2>&1
}

reload_service() {
	# The daemon re-reads UCI every tick, so a config change needs no restart.
	return 0
}

service_triggers() {
	procd_add_reload_trigger "cellguard"
}
