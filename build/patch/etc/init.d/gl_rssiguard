#!/bin/sh /etc/rc.common
#
# Minimum-RSSI enforcement for Wi-Fi clients.

START=96
STOP=10

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/bin/gl_rssiguard run
	procd_set_param respawn 5 10 -1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Anything left in a hostapd deny list would outlive the daemon and lock
	# a client out until the AP restarts.
	/usr/bin/lua /usr/bin/gl_rssiguard clear >/dev/null 2>&1
	rm -f /tmp/gl_rssiguard.json
}

reload_service() {
	# Config is re-read every poll, so nothing to restart.
	return 0
}

service_triggers() {
	procd_add_reload_trigger "rssiguard"
}
