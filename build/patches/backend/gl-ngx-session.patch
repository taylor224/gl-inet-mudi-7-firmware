+local function load_remember()
+    local f = io.open(REMEMBER_PATH)
+    if not f then return {} end
+    local raw = f:read('*a')
+    f:close()
+    local ok, decoded = pcall(cjson.decode, raw)
+    if not ok or type(decoded) ~= 'table' then return {} end
+    return decoded
+end
+
+local function save_remember(store)
+    local f = io.open(REMEMBER_PATH .. '.tmp', 'w')
+    if not f then
+        log.err('cannot write ' .. REMEMBER_PATH)
+        return
+    end
+    f:write(cjson.encode(store))
+    f:close()
+    os.rename(REMEMBER_PATH .. '.tmp', REMEMBER_PATH)
+    os.execute('sync')
+end
+
+local function prune_remember(store)
+    local now = os.time()
+    local kept = {}
+    local dropped = 0
+    for _, entry in ipairs(store) do
+        if entry.expires and entry.expires > now then
+            kept[#kept + 1] = entry
+        else
+            dropped = dropped + 1
+        end
+    end
+    return kept, dropped
+end
+
+-- A token is "<id>.<secret>". The id finds the record without the secret ever
+-- being used as a lookup key, so an expired or unknown id costs one lookup and
+-- nothing else.
+local function split_token(token)
+    if type(token) ~= 'string' then return nil, nil end
+    local id, secret = token:match('^(%w+)%.(%w+)$')
+    return id, secret
 end
 
